FROM rust:latest AS builder
WORKDIR /app/workers
COPY workers/Cargo.toml ./
COPY workers/src ./src
RUN cargo build --release --bin thumbnailer_worker

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/workers/target/release/thumbnailer_worker ./thumbnailer_worker
CMD ["./thumbnailer_worker"]

FROM rust:latest AS builder
WORKDIR /app/workers
COPY workers/Cargo.toml ./
COPY workers/src ./src
RUN cargo build --release --bin file_validator_worker

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/workers/target/release/file_validator_worker ./file_validator_worker
CMD ["./file_validator_worker"]
